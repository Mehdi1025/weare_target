# URL canonique du site (canonical, OG, sitemap) — doit être la même que le domaine principal sur Vercel
# Si www est principal : https://www.wearetarget.fr (recommandé, config actuelle Vercel)
# Si apex est principal : https://wearetarget.fr
NEXT_PUBLIC_SITE_URL=https://www.wearetarget.fr

# Formulaire contact (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Destinataire des messages du formulaire (nécessite le domaine wearetarget.fr vérifié sur Resend).
CONTACT_TO_EMAIL=adam@wearetarget.fr
# Expéditeur : onboarding@resend.dev tant que le domaine n’est pas vérifié, puis par ex. :
# CONTACT_FROM_EMAIL=Target Agency <contact@wearetarget.fr>
